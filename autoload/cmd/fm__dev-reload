# The hook of fm dev: reload FM when a source file is newer than the stamp of the last load
setopt LOCAL_OPTIONS EXTENDED_GLOB
local -P newest=( $fm__root/(fm.zsh|autoload/**/^*.zwc|preview/^*.zwc)(.om[1]N) )
if [[ $newest && $newest -nt $FM__TMP/dev-stamp ]]; then
	fm reload
	print "FM reloaded: ${newest#$fm__root/} changed"
fi

# fm__close-dialog [seconds|-notify]: report "$num $message" (plus [INTERRUPTED] or [ERROR n]) in the header.
# After a dialog it also prints the report in the dialog and waits the seconds (default 1) before the panel
# redraws; with -notify (commands with no dialog) and in widget mode (no dialogs there) it only notifies.
local -P arg=$1 note res=$?

if [[ $TRY_BLOCK_INTERRUPT -gt 0 ]]; then
	TRY_BLOCK_INTERRUPT=0
	note=' [INTERRUPTED]'
elif [[ $res -gt 0 ]]; then
	note=" [ERROR $res]"
fi

fm__notify "$num $message$note"
if [[ $arg == -notify || $fm_mode == widget ]] return 0

fm__print -magenta "\n$num $message$note" > /dev/tty
sleep ${arg:-1}

tput csr 0 $(tput lines)

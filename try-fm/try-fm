# try-fm: FM in a container (docker or podman), to try it without installing it or to run its test suite.
# Standalone:  sh -c "curl -fsSL https://raw.githubusercontent.com/ddnexus/fm/master/try-fm/try-fm -o ~/try-fm; chmod +x ~/try-fm; ~/try-fm"
# From a clone of the repo: try-fm/try-fm (the image is built from the working copy, and `test` mounts it)

set -e

name=try-fm
image=$name
volume=${name}_home
root="$(cd -P -- "$(dirname -- "$0")" && pwd -P)"
if [ -f "$root/../fm.zsh" ]; then
	repo="$(cd -P -- "$root/.." && pwd -P)"
	context=${TRY_FM_CONTEXT:-$repo}
else
	repo=''
	context=${TRY_FM_CONTEXT:-https://github.com/ddnexus/fm.git#master}
fi

engine=${TRY_FM_ENGINE:-}
if [ -z "$engine" ]; then
	if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
		engine=docker
	elif command -v podman >/dev/null 2>&1; then
		engine=podman
	else
		echo "Neither docker nor podman is available (install one of them, or set TRY_FM_ENGINE)"
		exit 1
	fi
fi
run_opts=''
case $engine in
	*podman*) run_opts='--userns=keep-id --security-opt label=disable' ;; # rootless: the host files stay owned by the user; no SELinux relabeling
esac

has_image()  { $engine image inspect $image >/dev/null 2>&1; }
has_volume() { $engine volume inspect $volume >/dev/null 2>&1; }

build() {
	echo "Building the '$image' image with $engine from $context (a few minutes the first time)..."
	$engine build \
			--tag $image \
			--file try-fm/Dockerfile \
			--build-arg user="$(id -un)" \
			--build-arg uid="$(id -u)" \
			--build-arg gid="$(id -g)" \
			"$context"
	echo "The '$image' image is built"
}

case "${1:-}" in
	start|s)
		has_image || build
		case "${2:-}" in
			--root-mount|-r|'')
				mount_info="* Your filesystem is mounted at /$(hostname): the changes made there are real"
				mount_opts="--volume /:/$(hostname) --workdir /$(hostname)$HOME"
				;;
			--home-mount|-h)
				mount_info="* Your home dir is mounted at /$(hostname)$HOME: the changes made there are real"
				mount_opts="--volume $HOME:/$(hostname)$HOME --workdir /$(hostname)$HOME"
				;;
			--no-mount|-n)
				mount_info="* Nothing of your filesystem is mounted: experiment freely"
				mount_opts=''
				;;
			*)
				echo "The option '$2' is not supported"
				exit 1
				;;
		esac
		cat <<-INFO

			================================ TRY-FM SESSION ================================
			* Run 'fm' to start FM, ctrl-space for the menu with the usage notes, ctrl-q to quit
			* The widget: press alt-f twice while typing a command in the zsh prompt
			* bash and fish are installed with the FM launchers: 'fm' works there too
			* ~/playground is a tree of files to try the fs commands without risk
			* ~ persists between sessions, '~/$name reset' restores it; the sudo password is 'fm'
			$mount_info
			* Exit the session with 'exit'
			================================================================================
		INFO
		if ! has_volume && [ -n "$mount_opts" ]; then
			printf 'Press enter to confirm that you have read the above... '
			read -r _
		fi
		# shellcheck disable=SC2086
		exec $engine run \
				--name $name \
				--hostname $name \
				--interactive --tty --rm \
				--env TERM="${TERM:-xterm-256color}" \
				--volume $volume:/home/"$(id -un)" \
				$run_opts \
				$mount_opts \
				$image
		;;

	test|t)
		shift
		has_image || build
		if [ -n "$repo" ]; then
			mount_opts="--volume $repo:/opt/fm:ro" # the working copy, instead of the copy in the image
		else
			mount_opts=''
		fi
		# shellcheck disable=SC2086
		exec $engine run --rm $run_opts $mount_opts --env TERM="${TERM:-xterm-256color}" $image zsh /opt/fm/tests/run "$@"
		;;

	build|b)
		build
		;;

	reset|r)
		printf "Remove the '%s' volume (the HOME of the session)? (y/n) " $volume
		read -r input
		case "$input" in
			y|Y) $engine volume rm $volume && echo "Done: the next start recreates it" ;;
		esac
		;;

	purge|p)
		printf "Remove the '%s' image and volume? (y/n) " $name
		read -r input
		case "$input" in
			y|Y)
				has_volume && $engine volume rm $volume
				has_image && $engine rmi $image
				echo "Done. The base image fedora:44 was kept: remove it with '$engine rmi fedora:44' if you do not use it."
				[ -z "$repo" ] && echo "Remove this script with 'rm $root/$name'"
				;;
		esac
		;;

	usage|help|u|h|'')
		cat <<-USAGE

			==================================== USAGE =====================================
			$0 start|s          Build the image if needed and start the session...
			   [--root-mount|-r]  ...with your / mounted at /$(hostname) (default)
			    --home-mount|-h   ...with your home dir mounted at /$(hostname)$HOME
			      --no-mount|-n   ...with nothing of your filesystem mounted
			$0 test|t [ARGS]    Run the FM test suite in the container (ARGS: see tests/run -h)
			$0 build|b          Build the image again (e.g. to update FM)
			$0 reset|r          Remove the session HOME: the next start recreates it
			$0 purge|p          Remove the image and the session HOME
			$0 usage|u          Show this screen

			Engine: $engine (TRY_FM_ENGINE overrides). Build context: $context (TRY_FM_CONTEXT overrides)
			================================================================================
		USAGE
		;;

	*)
		echo "The subcommand '$1' is not supported"
		exit 1
		;;
esac
